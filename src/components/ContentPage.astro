---
// Shared shell for content pages (FAQ, location): breadcrumbs, title, optional intro, prose body.
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  crumbs: Crumb[];
  intro?: string;
}
const { title, intro, crumbs } = Astro.props;
---
<section class="section content">
  <article class="container prose">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="section-title">{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </article>
</section>

<style>
  .intro { font-size: 1.1rem; color: var(--text); max-width: 60ch; }
</style>

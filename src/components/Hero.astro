---
import { Picture } from 'astro:assets';
import ApplyForm from './ApplyForm.astro';
import heroBg from '../../assets/background.webp';
---
<section class="hero" id="home" aria-labelledby="hero-title">
  <!-- Decorative background (LCP image): responsive WebP generated at build time
       (AVIF came out larger than WebP for this already-compressed source) -->
  <Picture
    class="hero-bg"
    pictureAttributes={{ style: 'display: contents' }}
    src={heroBg}
    alt=""
    formats={['webp']}
    fallbackFormat="webp"
    widths={[640, 960, 1440, 1920, 2560]}
    sizes="100vw"
    quality={60}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="container hero-grid">
    <div class="hero-copy">
      <img class="hero-logo" src="/logo.svg" alt="Royal Finance" width="220" height="224" />
      <h1 id="hero-title">Бързо финансиране</h1>
      <p class="tagline">Твоите планове заслужават подкрепа</p>
      <p class="lead">
        Бърз кредит, кандидатствай онлайн. Кредит от 500 до 5&nbsp;000&nbsp;€ със срок от 3 до 60 месеца.
        Получете отговор до 10 минути.
      </p>
    </div>
    <ApplyForm />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Pulled up under the translucent sticky header so the photo shows through it */
    margin-top: calc(-1 * var(--header-h) - 1px);
    padding-block: calc(var(--header-h) + 2.5rem) 3.5rem;
    background: var(--bg);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 60%;
  }
  /* Dark overlay keeps the copy and form at WCAG AA contrast and fades into the next section */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.35) 45%, var(--bg) 100%),
      rgba(10, 10, 10, 0.55);
  }
  @media (min-width: 1024px) {
    .hero::before {
      background:
        radial-gradient(40rem 30rem at 22% 65%, rgba(10, 10, 10, 0.88), rgba(10, 10, 10, 0.6) 45%, transparent 75%),
        linear-gradient(90deg, rgba(10, 10, 10, 0.88) 0%, rgba(10, 10, 10, 0.55) 45%, rgba(10, 10, 10, 0.35) 70%, rgba(10, 10, 10, 0.6) 100%),
        linear-gradient(180deg, rgba(10, 10, 10, 0.3) 0%, transparent 30%, transparent 75%, var(--bg) 100%);
    }
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-copy { display: grid; gap: 1.25rem; justify-items: start; }
  .hero-logo { display: none; }
  h1 {
    font-size: clamp(2.1rem, 1.2rem + 2.6vw, 3.4rem);
    color: var(--text);
    max-width: 16ch;
  }
  .tagline {
    margin-top: -0.4rem;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.6rem);
    color: var(--gold-2);
  }
  .lead {
    font-size: 1.075rem;
    color: #d6cfc3; /* lighter than --text-muted: it sits on the photo */
    max-width: 44ch;
  }
  @media (min-width: 1024px) {
    .hero { padding-block: calc(var(--header-h) + 4rem) 5rem; }
    /* Tall enough for the longest form step, so the section keeps one height while
       the card grows and shrinks between steps (it is pinned to the top). */
    .hero-grid {
      grid-template-columns: 1fr minmax(26rem, 30rem);
      gap: 4.5rem;
      min-height: 56rem;
      align-items: start;
    }
    /* Copy starts level with the top of the form card */
    .hero-copy { align-self: start; }
    .hero-logo { display: block; width: 13.5rem; height: auto; margin-bottom: 0.5rem; }
  }
  /* Narrow desktops: smaller logo so the headline and intro stay above the fold */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero-logo { width: 10rem; }
  }
</style>

---
import { CalendarRange, ClipboardPen, UserRound, Zap } from '@lucide/astro';

const items = [
  { icon: Zap, title: 'Бързо одобрение', text: 'До 10 минути' },
  { icon: ClipboardPen, title: 'Лесно кандидатстване', text: 'Онлайн, с няколко полета' },
  { icon: CalendarRange, title: 'Гъвкави срокове', text: 'От 3 до 60 месеца' },
  // TODO-CLAIM: "Дискретност / Индивидуален подход" needs client confirmation
  { icon: UserRound, title: 'Дискретност', text: 'И индивидуален подход' },
];
---
<section class="benefits" aria-label="Предимства">
  <hr class="gold-rule" />
  <ul class="container list">
    {items.map(({ icon: Icon, title, text }) => (
      <li>
        <span class="icon-ring"><Icon aria-hidden="true" /></span>
        <div>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      </li>
    ))}
  </ul>
  <hr class="gold-rule" />
</section>

<style>
  .benefits { background: #0d0c0a; }
  .list {
    list-style: none;
    margin-block: 0;
    padding-block: 2rem;
    display: grid;
    gap: 1.5rem;
  }
  li { display: flex; align-items: center; gap: 1rem; }
  h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: var(--text); }
  p { font-size: 0.875rem; color: var(--text-muted); }
  @media (min-width: 640px) {
    .list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .list { grid-template-columns: repeat(4, 1fr); padding-block: 2.25rem; }
    li + li { border-left: 1px solid var(--border-gold); padding-left: 1.5rem; }
  }
</style>

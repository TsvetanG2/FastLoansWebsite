---
import { company } from '../data/company';

interface Props {
  title: string;
  /** Section anchors for the table of contents at the top. */
  toc: { id: string; label: string }[];
}
const { title, toc } = Astro.props;
---
<section class="section legal">
  <article class="container prose">
    <h1 class="section-title">{title}</h1>

    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">Съдържание</h2>
      <ol>
        {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
      </ol>
    </nav>

    <slot />

    <p class="effective">В сила от: {company.effectiveDate} г.</p>
  </article>
</section>

<style>
  .toc {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-gold);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
  }
  .toc h2 { margin-top: 0; font-size: 1rem; color: var(--text); }
  .toc ol { margin: 0.5rem 0 0; padding-left: 1.25rem; }
  .toc li { margin-top: 0.3rem; }

  .effective {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid #2b2721;
    font-size: 0.9rem;
  }
</style>

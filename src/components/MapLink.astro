---
// Address link to the office's Google Business Profile (reviews, photos, directions). The same URL
// on every device: Android opens it in the Google Maps app, elsewhere it opens in the browser.
import { company } from '../data/company';

interface Props { class?: string }
const { class: className } = Astro.props;
---
<a
  class={className}
  href={company.gbpUrl}
  target="_blank"
  rel="noopener"
  data-maps-link
  aria-label={`${company.officeAddress} — отвори в Google Maps`}
><slot /></a>

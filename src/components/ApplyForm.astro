---
import { ArrowLeft, ArrowRight, ChevronDown, CircleCheck, Lock, RotateCcw } from '@lucide/astro';
import { AMOUNT, HOUSING, PURPOSES, TERM, formatEur, formatMonths } from '../lib/application';
import { CITIES } from '../lib/cities';
import { agentStatement } from '../data/company';

const pct = (v: number, min: number, max: number) => `${((v - min) / (max - min)) * 100}%`;
const STEP_TITLES = ['Сума и срок', 'Лични данни', 'Адрес и работа', 'Потвърждение'];
---
<div class="apply" id="apply">
  <form class="apply-form" id="apply-form" novalidate data-step="1">
    <h2 class="apply-title">Кандидатствайте за кредит</h2>

    <div class="progress" aria-hidden="true">
      <p class="progress-label">
        Стъпка <span data-step-num>1</span> от {STEP_TITLES.length}: <span data-step-title>{STEP_TITLES[0]}</span>
      </p>
      <ol class="progress-bar">
        {STEP_TITLES.map(() => <li></li>)}
      </ol>
    </div>

    <div class="steps">
    <!-- Step 1: amount and term (quick and engaging first) -->
    <fieldset class="step" data-step-index="1">
      <legend class="visually-hidden">Стъпка 1 от {STEP_TITLES.length}: {STEP_TITLES[0]}</legend>

      <div class="field">
        <div class="field-head">
          <label for="amount">Желана сума</label>
          <!-- Display only: the amount is chosen with the slider -->
          <output id="amount-output" for="amount" class="amount-value">{formatEur(AMOUNT.initial)}</output>
        </div>
        <input
          id="amount"
          name="amount"
          class="range"
          type="range"
          min={AMOUNT.min}
          max={AMOUNT.max}
          step={AMOUNT.step}
          value={AMOUNT.initial}
          style={`--pct:${pct(AMOUNT.initial, AMOUNT.min, AMOUNT.max)}`}
          aria-valuetext={formatEur(AMOUNT.initial)}
          aria-describedby="amount-error"
        />
        <div class="range-limits" aria-hidden="true">
          <span>{formatEur(AMOUNT.min)}</span><span>{formatEur(AMOUNT.max)}</span>
        </div>
        <p class="error" id="amount-error" data-error-for="amount"></p>
      </div>

      <div class="field">
        <div class="field-head">
          <label for="term">Срок на изплащане</label>
          <output id="term-output" for="term" class="term-value">{formatMonths(TERM.initial)}</output>
        </div>
        <input
          id="term"
          name="term"
          class="range"
          type="range"
          min={TERM.min}
          max={TERM.max}
          step={TERM.step}
          value={TERM.initial}
          style={`--pct:${pct(TERM.initial, TERM.min, TERM.max)}`}
          aria-valuetext={formatMonths(TERM.initial)}
          aria-describedby="term-error"
        />
        <div class="range-limits" aria-hidden="true">
          <span>{formatMonths(TERM.min)}</span><span>{formatMonths(TERM.max)}</span>
        </div>
        <p class="error" id="term-error" data-error-for="term"></p>
      </div>

      <div class="nav">
        <button class="btn btn-gold" type="button" data-action="next">
          Продължете <ArrowRight aria-hidden="true" />
        </button>
      </div>
    </fieldset>

    <!-- Step 2: personal details -->
    <fieldset class="step" data-step-index="2" disabled>
      <legend class="visually-hidden">Стъпка 2 от {STEP_TITLES.length}: {STEP_TITLES[1]}</legend>

      <div class="row">
        <div class="field">
          <label for="firstName">Вашето име</label>
          <input id="firstName" name="firstName" type="text" autocomplete="given-name" maxlength="40" placeholder="Вашето име" required aria-describedby="firstName-error" />
          <p class="error" id="firstName-error" data-error-for="firstName"></p>
        </div>
        <div class="field">
          <label for="lastName">Вашата фамилия</label>
          <input id="lastName" name="lastName" type="text" autocomplete="family-name" maxlength="40" placeholder="Вашата фамилия" required aria-describedby="lastName-error" />
          <p class="error" id="lastName-error" data-error-for="lastName"></p>
        </div>
      </div>

      <div class="field">
        <label for="phone">Телефон за връзка</label>
        <div class="phone">
          <span class="phone-prefix" aria-hidden="true">+359</span>
          <input id="phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="888 123 456" maxlength="20" required aria-describedby="phone-prefix-hint phone-error" />
        </div>
        <span class="visually-hidden" id="phone-prefix-hint">Код +359 е добавен автоматично.</span>
        <p class="error" id="phone-error" data-error-for="phone"></p>
      </div>

      <div class="field">
        <label for="email">Имейл</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="Имейл" required aria-describedby="email-error" />
        <p class="error" id="email-error" data-error-for="email"></p>
      </div>

      <div class="nav">
        <button type="button" class="link-btn" data-action="back"><ArrowLeft aria-hidden="true" /> Назад</button>
        <button class="btn btn-gold" type="button" data-action="next">
          Продължете <ArrowRight aria-hidden="true" />
        </button>
      </div>
    </fieldset>

    <!-- Step 3: purpose, address, housing, work -->
    <fieldset class="step" data-step-index="3" disabled>
      <legend class="visually-hidden">Стъпка 3 от {STEP_TITLES.length}: {STEP_TITLES[2]}</legend>

      <div class="field">
        <label for="purpose">Причина за финансиране</label>
        <div class="select">
          <select id="purpose" name="purpose" required aria-describedby="purpose-error">
            <option value="" selected disabled>Причина за финансиране</option>
            {Object.entries(PURPOSES).map(([v, label]) => <option value={v}>{label}</option>)}
          </select>
          <ChevronDown aria-hidden="true" />
        </div>
        <p class="error" id="purpose-error" data-error-for="purpose"></p>
      </div>

      <div class="field">
        <label for="currentAddress">Настоящ адрес</label>
        <input id="currentAddress" name="currentAddress" type="text" autocomplete="street-address" maxlength="200" placeholder="Настоящ адрес" required aria-describedby="currentAddress-error" />
        <p class="error" id="currentAddress-error" data-error-for="currentAddress"></p>
      </div>

      <div class="field">
        <label for="idAddress">Адрес по лична карта</label>
        <input id="idAddress" name="idAddress" type="text" autocomplete="off" maxlength="200" placeholder="Адрес по лична карта" required aria-describedby="idAddress-error" />
        <p class="error" id="idAddress-error" data-error-for="idAddress"></p>
      </div>

      <div class="field">
        <label for="city">Град</label>
        <div class="select">
          <select id="city" name="city" autocomplete="address-level2" required aria-describedby="city-error">
            <option value="" selected disabled>Град</option>
            {CITIES.map((c) => <option value={c}>{c}</option>)}
          </select>
          <ChevronDown aria-hidden="true" />
        </div>
        <p class="error" id="city-error" data-error-for="city"></p>
      </div>

      <div class="field">
        <label for="housing">В собствено жилище ли живеете?</label>
        <div class="select">
          <select id="housing" name="housing" required aria-describedby="housing-error">
            <option value="" selected disabled>В собствено жилище ли живеете?</option>
            {Object.entries(HOUSING).map(([v, label]) => <option value={v}>{label}</option>)}
          </select>
          <ChevronDown aria-hidden="true" />
        </div>
        <p class="error" id="housing-error" data-error-for="housing"></p>
      </div>

      <div class="field">
        <label for="occupation">Какво работите</label>
        <input id="occupation" name="occupation" type="text" autocomplete="organization-title" maxlength="100" placeholder="Какво работите" required aria-describedby="occupation-error" />
        <p class="error" id="occupation-error" data-error-for="occupation"></p>
      </div>

      <div class="nav">
        <button type="button" class="link-btn" data-action="back"><ArrowLeft aria-hidden="true" /> Назад</button>
        <button class="btn btn-gold" type="button" data-action="next">
          Продължете <ArrowRight aria-hidden="true" />
        </button>
      </div>
    </fieldset>

    <!-- Step 4: consent and submit -->
    <fieldset class="step" data-step-index="4" disabled>
      <legend class="visually-hidden">Стъпка 4 от {STEP_TITLES.length}: {STEP_TITLES[3]}</legend>

      <div class="field field-check">
        <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-error" />
        <label for="consent">
          Приемам{" "}
          <a href="/terms" target="_blank" rel="noopener">Общите условия</a> и{" "}
          <a href="/privacy" target="_blank" rel="noopener">Политиката за поверителност</a>{" "}
          и съм съгласен/на личните ми данни да бъдат обработени за целите на заявката.
        </label>
        <p class="error" id="consent-error" data-error-for="consent"></p>
      </div>

      <!-- Honeypot: hidden from people and assistive tech, bots tend to fill it -->
      <div class="hp" aria-hidden="true">
        <label for="company_website">Уебсайт на фирмата</label>
        <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="turnstile" id="turnstile"></div>

      <div class="nav">
        <button type="button" class="link-btn" data-action="back"><ArrowLeft aria-hidden="true" /> Назад</button>
        <button class="btn btn-gold" type="submit" data-submit>
          <span data-label>Изпратете заявката</span> <ArrowRight aria-hidden="true" />
        </button>
      </div>

      <p class="disclaimer">
        Подаването на заявка не е договор за кредит. Договор се сключва след одобрение и предоставяне на
        преддоговорна информация.
      </p>
      <p class="disclaimer">{agentStatement}</p>
    </fieldset>
    </div>

    <div class="form-alert" id="form-alert" role="alert" hidden>
      <p id="form-alert-text"></p>
      <button type="button" class="btn btn-outline" data-action="retry" hidden>
        <RotateCcw aria-hidden="true" /> Опитайте отново
      </button>
    </div>

    <p class="secure"><Lock aria-hidden="true" /> Данните Ви се изпращат по защитена връзка</p>
    <p class="visually-hidden" id="form-status" aria-live="polite"></p>
    <noscript><p class="error">За да кандидатствате, включете JavaScript в браузъра си.</p></noscript>
  </form>

  <div class="apply-success" id="apply-success" tabindex="-1" hidden>
    <CircleCheck aria-hidden="true" />
    <h2>Заявката е изпратена</h2>
    <p>Получихме кандидатурата Ви. Ще се свържем с Вас на посочения телефон.</p>
  </div>
</div>

<script>
  import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
  import { FIELDS, STEPS, formatEur, formatMonths, validate, type Field, type FieldErrors } from '../lib/application';

  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
  };
  declare global {
    interface Window { turnstile?: Turnstile; }
  }

  const STEP_TITLES = ['Сума и срок', 'Лични данни', 'Адрес и работа', 'Потвърждение'];
  const LAST = STEPS.length;

  const form = document.getElementById('apply-form') as HTMLFormElement;
  const success = document.getElementById('apply-success') as HTMLElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
  const stepNum = form.querySelector('[data-step-num]')!;
  const stepTitle = form.querySelector('[data-step-title]')!;
  const bars = [...form.querySelectorAll<HTMLLIElement>('.progress-bar li')];
  const amount = form.elements.namedItem('amount') as HTMLInputElement; // the slider
  const amountOutput = document.getElementById('amount-output') as HTMLOutputElement;
  const term = form.elements.namedItem('term') as HTMLInputElement;
  const termOutput = document.getElementById('term-output') as HTMLOutputElement;
  const alertBox = document.getElementById('form-alert')!;
  const alertText = document.getElementById('form-alert-text')!;
  const retryBtn = alertBox.querySelector<HTMLButtonElement>('[data-action="retry"]')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const submitLabel = submitBtn.querySelector('[data-label]')!;
  const status = document.getElementById('form-status')!;

  const input = (f: Field) => form.elements.namedItem(f) as HTMLInputElement | HTMLSelectElement;
  const current = () => Number(form.dataset.step);

  // --- Sliders -------------------------------------------------------------
  const setFill = (r: HTMLInputElement) => {
    const min = Number(r.min), max = Number(r.max);
    r.style.setProperty('--pct', `${((Number(r.value) - min) / (max - min)) * 100}%`);
  };

  amount.addEventListener('input', () => {
    const text = formatEur(Number(amount.value));
    amountOutput.value = text;
    amount.setAttribute('aria-valuetext', text);
    setFill(amount);
    setError('amount');
  });
  term.addEventListener('input', () => {
    const text = formatMonths(Number(term.value));
    termOutput.value = text;
    term.setAttribute('aria-valuetext', text);
    setFill(term);
  });

  // --- Validation ----------------------------------------------------------
  const values = () =>
    Object.fromEntries(
      FIELDS.map((f) => {
        const el = input(f);
        return [f, el instanceof HTMLInputElement && el.type === 'checkbox' ? el.checked : el.value];
      }),
    );

  function setError(field: Field, message = '') {
    const el = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    if (el) el.textContent = message;
    input(field)?.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function showErrors(errors: FieldErrors, fields: Field[]) {
    for (const f of fields) setError(f, errors[f] ?? '');
    const first = fields.find((f) => errors[f]);
    if (first) input(first).focus();
    return !first;
  }

  function check(fields: Field[]) {
    const r = validate(values());
    return showErrors(r.ok ? {} : r.errors, fields);
  }

  // Once a field shows an error, clear it as soon as the value becomes valid.
  // New errors only appear on "Продължете"/submit: showing them on blur shifts
  // the layout under the pointer and swallows the click on the next field.
  for (const f of FIELDS) {
    if (f === 'amount' || f === 'term') continue;
    const el = input(f);
    const type = el instanceof HTMLSelectElement || (el as HTMLInputElement).type === 'checkbox' ? 'change' : 'input';
    el.addEventListener(type, () => {
      if (el.getAttribute('aria-invalid') !== 'true') return;
      const r = validate(values());
      if (r.ok || !r.errors[f]) setError(f);
    });
  }

  // --- Steps ---------------------------------------------------------------
  const stepsWrap = form.querySelector<HTMLElement>('.steps')!;
  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.2, 0.7, 0.2, 1)';
  let animating: Promise<void> | null = null;
  let maxReached = 1;

  // Old step fades (and slides) out, the box eases to the new step's height
  // while the new step fades (and slides) in. With reduced motion: fade and
  // height only, no sideways movement.
  async function swapSteps(from: HTMLFieldSetElement, to: HTMLFieldSetElement, dir: number, show: () => void) {
    if (from === to || !('animate' in stepsWrap)) return show();
    const slide = reducedMotion() ? 0 : 28;
    const h0 = stepsWrap.offsetHeight;
    await from.animate(
      [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-dir * slide}px)` }],
      { duration: 160, easing: 'ease-in' },
    ).finished;
    show();
    const h1 = stepsWrap.offsetHeight;
    stepsWrap.style.overflow = 'hidden';
    const grow = stepsWrap.animate([{ height: `${h0}px` }, { height: `${h1}px` }], { duration: 360, easing: EASE });
    const enter = to.animate(
      [{ opacity: 0, transform: `translateX(${dir * slide}px)` }, { opacity: 1, transform: 'none' }],
      { duration: 360, easing: EASE },
    );
    await Promise.all([grow.finished, enter.finished]);
    stepsWrap.style.overflow = '';
  }

  // Scroll along with the card as it changes size. Called right after the new
  // step is shown, when layout already has the final size but the height
  // animation has not started, so both move together with the same curve.
  // Desktop: centre the card in the space below the sticky header (or pin its
  // top under the header when it is taller than that). Mobile: always bring the
  // step label just below the header, so every step starts at the top of the screen.
  const isDesktop = matchMedia('(min-width: 1024px)');
  // Touch screens: moving focus into a text field opens the on-screen keyboard, and the
  // browser then scrolls to that field itself, overriding the scroll above.
  const isTouch = matchMedia('(pointer: coarse)');
  function followCard() {
    const header = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
    const card = form.parentElement!.getBoundingClientRect();
    let delta: number;
    if (isDesktop.matches) {
      const room = innerHeight - header;
      delta = card.height + 32 > room
        ? card.top - header - 16
        : card.top + card.height / 2 - (header + room / 2);
    } else {
      const label = form.querySelector('.progress')!.getBoundingClientRect().top;
      delta = label - header - 16;
      if (Math.abs(delta) < 8) return;
    }
    const max = document.documentElement.scrollHeight - innerHeight;
    scrollToY(Math.max(0, Math.min(max, scrollY + delta)), 360);
  }

  // rAF-driven so it matches the card animation exactly (and is not affected by
  // the CSS `scroll-behavior: smooth`, which would fight per-frame scrolling).
  let scrollRun = 0; // a newer scroll cancels the one still running
  function scrollToY(y: number, duration: number) {
    const y0 = scrollY;
    const d = y - y0;
    if (Math.abs(d) < 2) return;
    const run = ++scrollRun;
    const t0 = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const frame = (now: number) => {
      if (run !== scrollRun) return;
      const t = Math.min(1, (now - t0) / duration);
      scrollTo({ top: y0 + d * ease(t), behavior: 'instant' });
      if (t < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // Each step's bar fills with the share of its fields that are valid.
  // Amount and term start with valid values, so they count only once the visitor has moved the
  // slider or gone past the step — otherwise the first bar would be full before anyone touched it.
  const touched = new Set<Field>();
  amount.addEventListener('input', () => touched.add('amount'));
  term.addEventListener('input', () => touched.add('term'));
  function updateProgress() {
    const r = validate(values());
    const errors: FieldErrors = r.ok ? {} : r.errors;
    bars.forEach((bar, i) => {
      const fields = STEPS[i].filter((f) => (f !== 'amount' && f !== 'term') || touched.has(f) || maxReached > i + 1);
      const done = fields.filter((f) => !errors[f]).length;
      bar.style.setProperty('--p', String(done / STEPS[i].length));
    });
  }
  form.addEventListener('input', updateProgress);
  form.addEventListener('change', updateProgress);

  function goTo(step: number, focus = true) {
    if (animating) return animating;
    const from = steps[current() - 1];
    const to = steps[step - 1];
    const dir = step > current() ? 1 : -1;
    form.dataset.step = String(step);
    maxReached = Math.max(maxReached, step);
    updateProgress();
    stepNum.textContent = String(step);
    stepTitle.textContent = STEP_TITLES[step - 1];
    hideAlert();
    // Warm up Turnstile early so the token is ready by the last step
    if (step >= 2) loadTurnstile();
    status.textContent = `Стъпка ${step} от ${LAST}: ${STEP_TITLES[step - 1]}`;

    animating = swapSteps(from, to, dir, () => {
      steps.forEach((s, i) => (s.disabled = i + 1 !== step));
      followCard();
      if (focus) {
        if (isTouch.matches) {
          // Focus the step itself (screen readers read its legend) without opening the keyboard;
          // the keyboard opens when the visitor taps a field.
          to.tabIndex = -1;
          to.focus({ preventScroll: true });
        } else {
          to.querySelector<HTMLElement>('input:not([type=hidden]):not([tabindex="-1"]), select')?.focus({ preventScroll: true });
        }
      }
    })
      // Mobile: closing the keyboard can shift the page during the animation — re-align once at the end
      .then(() => { if (!isDesktop.matches) followCard(); })
      .finally(() => (animating = null));
    return animating;
  }

  function next() {
    if (animating) return;
    if (check(STEPS[current() - 1])) goTo(current() + 1);
  }

  form.querySelectorAll('[data-action="next"]').forEach((b) => b.addEventListener('click', next));
  form.querySelectorAll('[data-action="back"]').forEach((b) => b.addEventListener('click', () => goTo(current() - 1)));
  updateProgress();

  // --- Turnstile -----------------------------------------------------------
  let widgetId: string | undefined;
  let token = '';
  let tokenWaiters: ((t: string) => void)[] = [];

  function loadTurnstile() {
    if (document.getElementById('cf-turnstile-script')) return;
    (window as any).onTurnstileLoad = () => {
      widgetId = window.turnstile!.render(document.getElementById('turnstile')!, {
        sitekey: PUBLIC_TURNSTILE_SITE_KEY,
        action: 'apply', // verified server-side
        theme: 'dark',
        language: 'bg',
        appearance: 'interaction-only',
        callback: (t: string) => {
          token = t;
          tokenWaiters.forEach((w) => w(t));
          tokenWaiters = [];
        },
        'expired-callback': () => { token = ''; },
        'error-callback': () => { token = ''; },
      });
    };
    const s = document.createElement('script');
    s.id = 'cf-turnstile-script';
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
    s.async = true;
    document.head.append(s);
  }

  function getToken(timeoutMs = 15000): Promise<string> {
    if (token) return Promise.resolve(token);
    return new Promise((resolve) => {
      tokenWaiters.push(resolve);
      setTimeout(() => resolve(token), timeoutMs);
    });
  }

  function resetTurnstile() {
    token = '';
    if (widgetId && window.turnstile) window.turnstile.reset(widgetId);
  }

  // --- Submit --------------------------------------------------------------
  function showAlert(message: string, canRetry: boolean) {
    alertText.textContent = message;
    retryBtn.hidden = !canRetry;
    alertBox.hidden = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    alertBox.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
  }
  function hideAlert() {
    alertBox.hidden = true;
    alertText.textContent = '';
  }

  function setSubmitting(on: boolean) {
    submitBtn.disabled = on;
    submitLabel.textContent = on ? 'Изпращане…' : 'Изпратете заявката';
    form.setAttribute('aria-busy', String(on));
    status.textContent = on ? 'Изпращаме заявката…' : '';
  }

  async function submit() {
    hideAlert();
    // Re-check every step; jump back to the first one with a problem
    const r = validate(values());
    if (!r.ok) {
      const bad = STEPS.findIndex((fields) => fields.some((f) => r.errors[f]));
      if (bad + 1 !== current()) await goTo(bad + 1, false);
      showErrors(r.errors, STEPS[bad]);
      return;
    }

    setSubmitting(true);
    try {
      const turnstileToken = await getToken();
      if (!turnstileToken) {
        showAlert('Проверката, че не сте робот, не завърши. Опитайте отново.', true);
        resetTurnstile();
        return;
      }
      const res = await fetch('/api/apply', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          ...values(),
          company_website: (form.elements.namedItem('company_website') as HTMLInputElement).value,
          turnstileToken,
        }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        const card = form.parentElement!;
        const h0 = card.offsetHeight;
        form.hidden = true;
        success.hidden = false;
        success.focus({ preventScroll: true });
        followCard();
        if ('animate' in card) {
          const h1 = card.offsetHeight;
          card.style.overflow = 'hidden';
          success.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: 'ease-out' });
          card.animate([{ height: `${h0}px` }, { height: `${h1}px` }], { duration: 420, easing: EASE })
            .finished.then(() => (card.style.overflow = ''));
        }
        return;
      }
      if (res.status === 422 && data.errors) {
        const bad = STEPS.findIndex((fields) => fields.some((f) => data.errors[f]));
        if (bad >= 0) {
          await goTo(bad + 1, false);
          showErrors(data.errors, STEPS[bad]);
        }
        resetTurnstile();
        return;
      }
      // 429 says "try again later": a retry button right away would only hit the limit again
      showAlert(data.message ?? 'Заявката не беше изпратена заради технически проблем. Опитайте отново.', res.status !== 429);
      resetTurnstile();
    } catch {
      showAlert('Няма връзка със сървъра. Проверете интернет връзката си и опитайте отново.', true);
      resetTurnstile();
    } finally {
      setSubmitting(false);
    }
  }

  // Until the consent box is ticked the submit button looks inactive (dark, gold outline). It stays
  // clickable and focusable: a click shows the consent error instead of doing nothing silently.
  const consentBox = input('consent') as HTMLInputElement;
  const syncSubmit = () => {
    const off = !consentBox.checked;
    submitBtn.classList.toggle('is-inactive', off);
    submitBtn.setAttribute('aria-disabled', String(off));
  };
  consentBox.addEventListener('change', syncSubmit);
  syncSubmit();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (current() < LAST) next();
    else submit();
  });

  // Enter in a field = "Продължете" (steps 1–3) or "Изпратете заявката" (step 4).
  // The browser's own Enter-to-submit does not fire here: the form's first submit button
  // sits in the not-yet-active last step and is disabled. Selects keep their own Enter
  // (opening the list); Enter on buttons and links keeps its normal meaning.
  form.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.isComposing || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey) return;
    const el = e.target as HTMLElement;
    if (!(el instanceof HTMLInputElement) || el.type === 'hidden') return;
    e.preventDefault();
    if (animating || submitBtn.disabled) return;
    if (current() < LAST) next();
    else submit();
  });
  retryBtn.addEventListener('click', () => submit());
</script>


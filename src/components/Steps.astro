---
const steps = [
  { title: 'Попълни формата', text: 'Избери сума и срок и остави данни за контакт.' },
  { title: 'Получете отговор до 10 минути', text: 'Наш консултант се свързва с теб по телефона.' },
  { title: 'Вземи своя кредит', text: 'След одобрение от кредитора ще ти обясним как да получиш сумата.' },
];
---
<section class="section steps" aria-labelledby="steps-title">
  <hr class="gold-rule top" />
  <div class="container" data-reveal>
    <div class="intro">
      <h2 class="section-title" id="steps-title">Как да кандидатстваш?</h2>
      <p>Три стъпки до твоя кредит.</p>
    </div>

    <!-- A real sequence, so the numbers carry meaning; a gold line joins them -->
    <ol class="timeline">
      {steps.map(({ title, text }, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { position: relative; background: #0d0c0a; }
  .top { position: absolute; inset: 0 0 auto; }

  .intro { display: grid; gap: 0.75rem; margin-bottom: 2.5rem; }
  .intro p { color: var(--text-muted); }

  .timeline {
    --num: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  /* Mobile: vertical, number in a left column, line running down between numbers */
  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--num) 1fr;
    align-content: start; /* shorter steps must not stretch their rows */
    column-gap: 1.25rem;
    row-gap: 0.35rem;
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--num) / 2);
    top: calc(var(--num) + 0.5rem);
    bottom: calc(-2rem + 0.5rem);
    width: 1px;
    background: linear-gradient(var(--gold-1), rgba(201, 162, 74, 0.15));
  }
  .num {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: var(--num);
    height: var(--num);
    border: 1px solid var(--gold-1);
    border-radius: 50%;
    background: #0d0c0a;
    color: var(--gold-2);
    font: 600 1.35rem/1 var(--font-serif);
  }
  h3 {
    align-self: center;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
  }
  li p { grid-column: 2; color: var(--text-muted); max-width: 34ch; }

  /* Desktop: three equal columns, numbers on one line joined left to right */
  @media (min-width: 1024px) {
    .intro { margin-bottom: 3.5rem; }
    .timeline { grid-template-columns: repeat(3, 1fr); gap: 3rem; }
    li { grid-template-columns: 1fr; row-gap: 0.6rem; }
    .num { grid-row: auto; margin-bottom: 0.9rem; }
    h3 { align-self: start; }
    li p { grid-column: 1; }
    li:not(:last-child)::after {
      left: calc(var(--num) + 1rem);
      right: -2rem;
      top: calc(var(--num) / 2);
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--gold-1), rgba(201, 162, 74, 0.15));
    }
  }
</style>

---
const steps = [
  // Client copy (2026-10-23)
  { title: 'Кандидатствайте онлайн', text: 'Изберете сума и срок, попълнете онлайн формата.' },
  { title: 'Получете одобрение', text: 'След разглеждане на Вашата кандидатура ще получите информация относно нея.' },
  { title: 'Вземете желаната сума', text: 'След одобрение получавате желаната сума!' },
];
---
<section class="section steps" aria-labelledby="steps-title">
  <hr class="gold-rule top" />
  <div class="container" data-reveal>
    <div class="intro">
      <h2 class="section-title" id="steps-title">Как да кандидатствате?</h2>
      <p>Три стъпки до Вашия кредит.</p>
    </div>

    <!-- A real sequence (an ordered list for screen readers); gold dots on a line show the order -->
    <ol class="timeline">
      {steps.map(({ title, text }) => (
        <li>
          <span class="dot" aria-hidden="true"></span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { position: relative; background: #0d0c0a; }
  .top { position: absolute; inset: 0 0 auto; }

  .intro { display: grid; gap: 0.75rem; margin-bottom: 2.5rem; }
  .intro p { color: var(--text-muted); }

  .timeline {
    --num: 0.85rem; /* the dot */
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  /* Mobile: vertical, dot in a left column, line running down between dots */
  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--num) 1fr;
    align-content: start; /* shorter steps must not stretch their rows */
    column-gap: 1rem;
    row-gap: 0.35rem;
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--num) / 2);
    top: calc(0.45rem + var(--num) + 0.35rem);
    bottom: calc(-2rem + 0.45rem - 0.35rem);
    width: 1px;
    background: linear-gradient(var(--gold-1), rgba(201, 162, 74, 0.15));
  }
  .dot {
    grid-row: span 2;
    margin-top: 0.45rem; /* level with the heading's first line */
    width: var(--num);
    height: var(--num);
    border: 1px solid var(--gold-1);
    border-radius: 50%;
    background: radial-gradient(circle, var(--gold-2) 0 35%, transparent 40%), #0d0c0a;
  }
  h3 {
    align-self: center;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
  }
  li p { grid-column: 2; color: var(--text-muted); max-width: 34ch; }

  /* Desktop: three equal columns, dots on one line joined left to right */
  @media (min-width: 1024px) {
    .intro { margin-bottom: 3.5rem; }
    .timeline { grid-template-columns: repeat(3, 1fr); gap: 3rem; }
    li { grid-template-columns: 1fr; row-gap: 0.6rem; }
    .dot { grid-row: auto; margin: 0 0 0.9rem; }
    h3 { align-self: start; }
    li p { grid-column: 1; }
    li:not(:last-child)::after {
      left: calc(var(--num) + 0.6rem);
      right: -2.4rem;
      top: calc(var(--num) / 2);
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--gold-1), rgba(201, 162, 74, 0.15));
    }
  }
</style>

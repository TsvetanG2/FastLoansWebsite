---
import { CircleCheck, ClipboardPen, Clock } from '@lucide/astro';

const steps = [
  { icon: ClipboardPen, title: 'Попълни формата', text: 'Избери сума и срок и остави данни за контакт.' },
  { icon: Clock, title: 'Получете отговор до 10 минути', text: 'Наш консултант се свързва с теб по телефона.' },
  { icon: CircleCheck, title: 'Вземи своя кредит', text: 'След одобрение уточняваме как да получиш сумата.' },
];
---
<section class="section steps" aria-labelledby="steps-title">
  <hr class="gold-rule top" />
  <div class="container grid" data-reveal>
    <div class="intro">
      <h2 class="section-title" id="steps-title">Как да кандидатстваш?</h2>
      <p>Три стъпки до твоя кредит.</p>
    </div>
    <ol class="list">
      {steps.map(({ icon: Icon, title, text }, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <div>
            <h3><Icon aria-hidden="true" />{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { position: relative; background: #0d0c0a; }
  .top { position: absolute; inset: 0 0 auto; }
  .grid { display: grid; gap: 2.5rem; }
  .intro { display: grid; gap: 0.75rem; }
  .intro p { color: var(--text-muted); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; }
  li { display: flex; gap: 1rem; align-items: flex-start; }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: #14100a;
    font: 700 1rem/1 var(--font-serif);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  h3 :global(svg) { flex: none; width: 1.2rem; height: 1.2rem; color: var(--gold-2); stroke-width: 1.5; }
  li p { font-size: 0.9rem; color: var(--text-muted); max-width: 32ch; }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: 16rem 1fr; gap: 3rem; align-items: start; }
    .list { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    li + li { border-left: 1px solid var(--border-gold); padding-left: 2rem; }
  }
</style>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { breadcrumbs, canonicalUrl, financialService, jsonLd } from '../lib/seo';
// Preload the subsets the first screen needs — same files the @font-face rules use. Cyrillic for
// the Bulgarian text, Latin for digits, "€" and "Royal Finance" (otherwise a second swap shifts the layout).
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import manropeLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import playfairCyr from '@fontsource-variable/playfair-display/files/playfair-display-cyrillic-wght-normal.woff2?url';
import playfairLat from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Subpage trail for BreadcrumbList, e.g. [{ name: 'Въпроси', path: '/faq' }] */
  crumbs?: { name: string; path: string }[];
  /** Extra JSON-LD objects for this page (e.g. FAQPage) */
  schema?: object[];
  /** 404 / maintenance: keep out of search results */
  noindex?: boolean;
}
const { title, description, crumbs, schema = [], noindex = false } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
// The share image must be fetchable by Facebook/Viber/WhatsApp, so it uses the address the site is
// really served from: Vercel's production domain at build time (the *.vercel.app one until
// royalfinance.bg is connected, then royalfinance.bg automatically). Canonical stays royalfinance.bg.
const servedFrom = process.env.VERCEL_PROJECT_PRODUCTION_URL
  ? `https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}`
  : Astro.site;
const ogImage = new URL('/og.png', servedFrom);
const ogUrl = new URL(new URL(canonical).pathname, servedFrom).href; // same path as canonical
const structured = noindex ? [] : [financialService(), ...(crumbs?.length ? [breadcrumbs(crumbs)] : []), ...schema];
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {[manropeCyr, manropeLat, playfairCyr, playfairLat].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="Royal Finance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Royal Finance — лого" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Structured data: data blocks, not executed, so the strict script-src CSP does not apply -->
    {structured.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}

  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            // Also reveal sections already scrolled past: a jump (End key, footer link) can skip
            // over a section without it ever intersecting, which would leave it hidden.
            if (!e.isIntersecting && e.boundingClientRect.top > 0) continue;
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
      );
      const pending = new Set(document.querySelectorAll('[data-reveal]'));
      pending.forEach((el) => io.observe(el));
      // A jump from below the screen to above it never makes the section intersect, so the
      // observer stays silent: on scroll, reveal anything that is already above the fold.
      let ticking = false;
      const catchUp = () => {
        ticking = false;
        for (const el of pending) {
          if (el.classList.contains('is-visible')) { pending.delete(el); continue; }
          if (el.getBoundingClientRect().top < 0) {
            el.classList.add('is-visible');
            io.unobserve(el);
            pending.delete(el);
          }
        }
        if (!pending.size) removeEventListener('scroll', onScroll);
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(catchUp); }
      };
      addEventListener('scroll', onScroll, { passive: true });
    </script>
    <!-- Vercel Web Analytics: cookieless, same-origin script (/_vercel/insights) — fits the CSP -->
    <Analytics />
  </body>
</html>

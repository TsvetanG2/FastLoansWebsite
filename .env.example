# Set these in Vercel -> Settings -> Environment Variables. Locally, copy to .env.

# Resend (server only, never exposed to the browser)
RESEND_API_KEY=
# Verified sender, e.g. "Royal Finance <noreply@royalfinance.bg>"
EMAIL_FROM=
# Where new applications are sent
LEADS_EMAIL_TO=

# Cloudflare Turnstile. Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

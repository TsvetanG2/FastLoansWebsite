# Set these in Vercel -> Settings -> Environment Variables. Locally, copy to .env.
# Only PUBLIC_TURNSTILE_SITE_KEY reaches the browser; everything else is server-only.

# Resend — a sending-only key restricted to the royalfinance.bg domain
RESEND_API_KEY=
# Verified sender, e.g. "Royal Finance <noreply@royalfinance.bg>"
EMAIL_FROM=
# Where new applications are sent
LEADS_EMAIL_TO=

# Cloudflare Turnstile. Test keys that always pass (accepted by the server only in local dev):
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting — Upstash Redis in eu-central-1, connected via the Vercel Marketplace.
# (If the integration creates KV_REST_API_URL / KV_REST_API_TOKEN instead, those work too.)
# Without them the API still works, but without rate limits (a warning is logged).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret mixed into the hashed rate-limit keys, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=

# Optional: extra allowed origins for /api/apply, comma-separated, e.g. while the site still
# runs on its *.vercel.app URL: https://royal-finance.vercel.app
# (https://royalfinance.bg and https://www.royalfinance.bg are always allowed)
ALLOWED_ORIGINS=

# Incoming mail: Resend Receiving → webhook https://royalfinance.bg/api/inbound (event email.received)
RESEND_WEBHOOK_SECRET=      # signing secret from Resend → Webhooks (whsec_…)
INBOUND_ADDRESSES=finance@royalfinance.bg   # our public address(es), comma-separated
INBOUND_FORWARD_TO=royalfinance@abv.bg      # where they are forwarded, comma-separated
